# Optional host service. Review and install explicitly; CI never installs it.
# User=/paths below are this VPS's; adjust them for another host.
# Run as the account already authenticated with Claude Code.
[Unit]
Description=Phone Use Claude Code planner bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liuyang
Group=liuyang
WorkingDirectory=/home/liuyang/apps/phone-use-cc-bridge
EnvironmentFile=-/home/liuyang/.config/phone-use-cc-bridge.env
ExecStart=/usr/bin/python3 -I /home/liuyang/apps/phone-use-cc-bridge/bridge.py --socket /srv/containers/iphone-control/cc/bridge.sock --work-dir /srv/containers/iphone-control/cc/work --claude-bin /home/liuyang/.local/bin/claude
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
# Caps runaway planner memory.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
