{
  "name": "iphone-control-browser-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-device-install.mjs",
    "prebuild": "node scripts/patch-device-install.mjs",
    "prebuild:assets": "node scripts/patch-device-install.mjs",
    "preweb:dev": "node scripts/patch-device-install.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "sh scripts/start-gateway.sh",
    "start": "sh scripts/start-gateway.sh",
    "web:dev": "npm run wasm:build && vite --host 127.0.0.1",
    "build": "WASM_BUILD_PROFILE=release npm run wasm:build && vite build",
    "typecheck": "cargo +1.90.0 check --locked -p ictl-web --target wasm32-unknown-unknown --manifest-path ../Cargo.toml",
    "test:rust": "sh scripts/test-rust.sh",
    "wasm:build": "sh scripts/build-wasm.sh",
    "pretest": "npm run wasm:build && npm run build:assets",
    "build:assets": "vite build",
    "test:browser": "npm run wasm:build && npm run build:assets && node --test tests/browser-ui.test.mjs"
  },
  "dependencies": {
    "@limrun/device-install": "0.1.0",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "2.5.3",
    "@yume-chan/stream-extra": "2.6.1",
    "plist": "5.1.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "vite": "8.3.7",
    "playwright": "1.65.0"
  }
}
